{
  "name": "taxflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "financeExtension": {
    "id": "taxflow",
    "displayName": "Taxflow",
    "version": "0.1.0",
    "description": "Taxflow extension",
    "themeColor": "#6366F1",
    "activationEvents": ["onView:taxflow"],
    "contributions": {
      "views": [{ "id": "taxflow", "name": "Taxflow", "icon": "assets/icon.svg" }],
      "commands": [{ "id": "taxflow.hello", "title": "Taxflow: Hello" }],
      "navigation": [{ "id": "taxflow-main", "label": "Taxflow", "command": "taxflow.hello", "group": "Taxflow" }],
      "configuration": [
        { "key": "taxflow.themeColor", "type": "string", "label": "Accent color for icons, topbar actions, and in-view highlights (hex).", "default": "#6366F1", "pattern": "^#[0-9A-Fa-f]{6}$", "formatHint": "#RRGGBB", "placeholder": "#6366F1" }
      ],
      "allowedCommands": ["taxflow.hello"],
      "allowedUiEvents": []
    },
    "main": "src/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "node D:/finance_flow_ai/scripts/sdk/cli.mjs build .",
    "version:bump": "node scripts/version-bump.mjs",
    "release": "node scripts/version-bump.mjs && node D:/finance_flow_ai/scripts/sdk/cli.mjs build ."
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "lit": "^3.1.0"
  }
}
